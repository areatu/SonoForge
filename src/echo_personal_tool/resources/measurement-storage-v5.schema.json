{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SonoForge measurement snapshot v5",
  "description": "v5 adds per-result Simpson/Doppler/derived provenance bases (QH-1b.2 slices 3a-c). v4 fields (BSA provenance, manual calculator inputs) remain. Old v1-v4 docs load with new fields absent (unverified).",
  "type": "object",
  "required": [
    "data",
    "format",
    "measurement_semantics_version",
    "revision",
    "saved_at",
    "schema_version",
    "sources",
    "study_uid"
  ],
  "properties": {
    "format": {
      "const": "sonoforge.study-measurements"
    },
    "schema_version": {
      "const": 5
    },
    "study_uid": {
      "type": "string",
      "maxLength": 64
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "saved_at": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "object",
      "maxProperties": 10000,
      "additionalProperties": {
        "type": "object",
        "required": [
          "fingerprint",
          "frames",
          "spacing"
        ],
        "additionalProperties": false,
        "properties": {
          "fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "frames": {
            "type": "integer",
            "minimum": 1
          },
          "spacing": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            ]
          }
        }
      }
    },
    "data": {
      "$ref": "#/$defs/StudyMeasurementData"
    },
    "measurement_semantics_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Meaning of Doppler labels/units; 2 = repeated measurements of one parameter are a list (D-23)."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "BsaBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "value"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 4
            }
          ]
        },
        "source": {
          "enum": [
            "derived",
            "manual",
            "missing"
          ]
        },
        "height_cm": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 300
            }
          ]
        },
        "weight_kg": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 700
            }
          ]
        }
      }
    },
    "CalibrationRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "maxLength": 64
        },
        "value": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "type": "string",
          "maxLength": 64
        },
        "source_instance_uid": {
          "type": "string",
          "maxLength": 256
        },
        "manual": {
          "type": "boolean"
        }
      },
      "required": [
        "kind"
      ]
    },
    "Contour": {
      "type": "object",
      "properties": {
        "apex_landmark": {
          "anyOf": [
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "null"
            }
          ]
        },
        "chamber": {
          "type": "string"
        },
        "frame_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "measurement_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "mitral_annulus": {
          "anyOf": [
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "minItems": 2,
                  "maxItems": 2
                },
                {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "minItems": 2,
                  "maxItems": 2
                }
              ],
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "null"
            }
          ]
        },
        "num_nodes": {
          "type": "integer"
        },
        "phase": {
          "type": "string"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "refine_locked_indices": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "refine_step": {
          "type": "integer"
        },
        "review_pending": {
          "type": "boolean"
        },
        "sop_instance_uid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string"
        },
        "unassisted": {
          "type": "boolean"
        },
        "view": {
          "type": "string"
        },
        "measurement_id": {
          "type": "string",
          "maxLength": 256
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "apex_landmark",
        "chamber",
        "frame_index",
        "measurement_label",
        "mitral_annulus",
        "num_nodes",
        "phase",
        "points",
        "refine_locked_indices",
        "refine_step",
        "review_pending",
        "sop_instance_uid",
        "source",
        "unassisted",
        "view"
      ],
      "additionalProperties": false
    },
    "DopplerCalibrationState": {
      "type": "object",
      "properties": {
        "baseline_y_px": {
          "type": "number"
        },
        "from_dicom_tags": {
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "spectral",
            "tissue"
          ]
        },
        "roi": {
          "$ref": "#/$defs/DopplerSpectrogramRoi"
        },
        "time_from_dicom_tags": {
          "type": "boolean"
        },
        "time_origin_ms": {
          "type": "number"
        },
        "time_span_ms": {
          "type": "number"
        },
        "velocity_from_dicom_tags": {
          "type": "boolean"
        },
        "velocity_per_pixel_cm_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "velocity_sign": {
          "type": "integer"
        },
        "velocity_span_cm_s": {
          "type": "number"
        }
      },
      "required": [
        "baseline_y_px",
        "from_dicom_tags",
        "kind",
        "roi",
        "time_from_dicom_tags",
        "time_origin_ms",
        "time_span_ms",
        "velocity_from_dicom_tags",
        "velocity_per_pixel_cm_s",
        "velocity_sign",
        "velocity_span_cm_s"
      ],
      "additionalProperties": false
    },
    "DopplerIntervalMarker": {
      "type": "object",
      "properties": {
        "end_time_ms": {
          "type": "number"
        },
        "label": {
          "type": "string"
        },
        "start_time_ms": {
          "type": "number"
        },
        "measurement_id": {
          "type": "string",
          "maxLength": 256,
          "description": "Identity of the measurement act (D-23); empty in legacy documents."
        }
      },
      "required": [
        "end_time_ms",
        "label",
        "start_time_ms"
      ],
      "additionalProperties": false
    },
    "DopplerMeasurementDTO": {
      "type": "object",
      "properties": {
        "intervals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DopplerIntervalMarker"
          }
        },
        "peaks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DopplerPeakMarker"
          }
        },
        "traces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DopplerTrace"
          }
        }
      },
      "required": [
        "intervals",
        "peaks",
        "traces"
      ],
      "additionalProperties": false
    },
    "DopplerPeakMarker": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "time_ms": {
          "type": "number"
        },
        "velocity_cm_s": {
          "type": "number"
        },
        "measurement_id": {
          "type": "string",
          "maxLength": 256,
          "description": "Identity of the measurement act (D-23); empty in legacy documents."
        },
        "mode": {
          "type": "string",
          "enum": [
            "",
            "CW",
            "PW",
            "TDI"
          ],
          "description": "Acquisition mode captured at measurement time (E2); empty when unknown."
        }
      },
      "required": [
        "label",
        "time_ms",
        "velocity_cm_s"
      ],
      "additionalProperties": false
    },
    "DopplerSpectrogramRoi": {
      "type": "object",
      "properties": {
        "height": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "x0": {
          "type": "number"
        },
        "y0": {
          "type": "number"
        }
      },
      "required": [
        "height",
        "width",
        "x0",
        "y0"
      ],
      "additionalProperties": false
    },
    "DopplerTrace": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "measurement_id": {
          "type": "string",
          "maxLength": 256,
          "description": "Identity of the measurement act (D-23); empty in legacy documents."
        },
        "mode": {
          "type": "string",
          "enum": [
            "",
            "CW",
            "PW",
            "TDI"
          ],
          "description": "Acquisition mode captured at measurement time (E2); empty when unknown."
        }
      },
      "required": [
        "label",
        "points"
      ],
      "additionalProperties": false
    },
    "InputReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "measurement_id": {
          "type": "string",
          "maxLength": 256
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "type": "string",
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "measurement_id"
      ]
    },
    "LinearMeasurement": {
      "type": "object",
      "properties": {
        "doppler": {
          "type": "boolean"
        },
        "end": {
          "anyOf": [
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "null"
            }
          ]
        },
        "frame_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "type": "string"
        },
        "millimeter_length": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "pixel_length": {
          "type": "number"
        },
        "sop_instance_uid": {
          "type": "string"
        },
        "start": {
          "anyOf": [
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "null"
            }
          ]
        },
        "time_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "velocity_cm_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "doppler_mode": {
          "type": "string",
          "enum": [
            "",
            "CW",
            "PW",
            "TDI"
          ],
          "description": "Acquisition mode captured at measurement time (E2); empty when unknown."
        },
        "measurement_id": {
          "type": "string",
          "maxLength": 256
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "doppler",
        "end",
        "frame_index",
        "label",
        "millimeter_length",
        "pixel_length",
        "sop_instance_uid",
        "start",
        "time_ms",
        "velocity_cm_s"
      ],
      "additionalProperties": false
    },
    "ManualCalculatorInput": {
      "type": "object",
      "properties": {
        "input_id": {
          "type": "string",
          "maxLength": 64
        },
        "origin": {
          "const": "manual"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "input_id",
        "origin",
        "revision",
        "value"
      ],
      "additionalProperties": false
    },
    "MethodIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method_id": {
          "type": "string",
          "maxLength": 256
        },
        "semantics_version": {
          "type": "integer",
          "minimum": 0
        },
        "algorithm_version": {
          "type": "string",
          "maxLength": 256
        },
        "config_digest": {
          "type": "string",
          "maxLength": 256
        },
        "model_id": {
          "type": "string",
          "maxLength": 256
        },
        "model_hash": {
          "type": "string",
          "maxLength": 256
        },
        "definition": {
          "type": "string",
          "maxLength": 1024
        },
        "units": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "method_id"
      ]
    },
    "MmodeCalibrationState": {
      "type": "object",
      "properties": {
        "depth_from_dicom_tags": {
          "type": "boolean"
        },
        "from_dicom_tags": {
          "type": "boolean"
        },
        "horizontal_ms_per_pixel": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "roi": {
          "$ref": "#/$defs/DopplerSpectrogramRoi"
        },
        "time_from_dicom_tags": {
          "type": "boolean"
        },
        "vertical_mm_per_pixel": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
