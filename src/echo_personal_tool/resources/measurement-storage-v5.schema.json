        "horizontal_ms_per_pixel",
        "roi",
        "time_from_dicom_tags",
        "vertical_mm_per_pixel"
      ],
      "additionalProperties": false
    },
    "ResultProvenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "result_id": {
          "type": "string",
          "maxLength": 256
        },
        "method": {
          "$ref": "#/$defs/MethodIdentity"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InputReference"
          },
          "maxItems": 1000
        },
        "calibration": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CalibrationRef"
          },
          "maxItems": 32
        },
        "units": {
          "type": "string",
          "maxLength": 64
        },
        "definition": {
          "type": "string",
          "maxLength": 1024
        },
        "qc": {
          "$ref": "#/$defs/ResultQC"
        },
        "freshness": {
          "enum": [
            "fresh",
            "stale",
            "unverified",
            "unavailable"
          ]
        },
        "freshness_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "maxItems": 16
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "family": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "result_id",
        "method",
        "freshness"
      ]
    },
    "ResultQC": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "valid",
            "review",
            "invalid",
            "unverified"
          ]
        },
        "coverage": {
          "type": "number"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 256
          },
          "maxItems": 16
        },
        "fallback": {
          "type": "string",
          "maxLength": 256
        },
        "interpolated_fraction": {
          "type": "number"
        },
        "rejected_fraction": {
          "type": "number"
        }
      },
      "required": [
        "status"
      ]
    },
    "SourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "study_uid": {
          "type": "string",
          "maxLength": 256
        },
        "sop_instance_uid": {
          "type": "string",
          "maxLength": 256
        },
        "series_uid": {
          "type": "string",
          "maxLength": 256
        },
        "frame_index": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "fingerprint": {
          "type": "string",
          "maxLength": 256
        },
        "ed_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "es_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "cycle_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "cycle_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "roi": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4
            },
            {
              "type": "null"
            }
          ]
        },
        "view": {
          "type": "string"
        },
        "chamber": {
          "type": "string"
        }
      },
      "required": [
        "study_uid"
      ]
    },
    "StrainReport": {
      "type": "object",
      "properties": {
        "avc_source_by_view": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
