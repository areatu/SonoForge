          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "qc_by_view": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "segmentation": {
          "type": "string"
        },
        "segments_missing": {
          "type": "integer"
        },
        "views_valid": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "avc_source_by_view",
        "contour_source",
        "gls_average",
        "gls_by_view",
        "qc_by_view",
        "segmentation",
        "segments_missing",
        "views_valid"
      ],
      "additionalProperties": false
    },
    "StudyMeasurementData": {
      "type": "object",
      "properties": {
        "bsa_basis": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/BsaBasis"
            }
          ]
        },
        "cine_segment_roi_by_instance": {
          "type": "array",
