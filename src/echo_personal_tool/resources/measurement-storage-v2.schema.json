              "type": "null"
            }
          ]
        },
        "chamber": {
          "type": "string"
        },
        "frame_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "measurement_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "mitral_annulus": {
          "anyOf": [
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "minItems": 2,
                  "maxItems": 2
                },
                {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "minItems": 2,
                  "maxItems": 2
                }
              ],
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "null"
            }
          ]
        },
        "num_nodes": {
          "type": "integer"
        },
        "phase": {
          "type": "string"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "refine_locked_indices": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "refine_step": {
          "type": "integer"
        },
        "review_pending": {
          "type": "boolean"
        },
        "sop_instance_uid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string"
        },
        "view": {
          "type": "string"
        }
      },
      "required": [
        "apex_landmark",
        "chamber",
        "frame_index",
        "measurement_label",
        "mitral_annulus",
        "num_nodes",
        "phase",
        "points",
        "refine_locked_indices",
        "refine_step",
        "review_pending",
        "sop_instance_uid",
        "source",
        "view"
      ],
      "additionalProperties": false
