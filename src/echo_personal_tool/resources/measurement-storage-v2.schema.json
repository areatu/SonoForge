{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SonoForge measurement snapshot v2",
  "description": "Structural contract of the version-2 document (D-23): repeated Doppler measurements of one parameter are allowed, each carries a measurement_id, and the envelope declares measurement_semantics_version. The codec also enforces bounded input, source references, frame bounds, unique measurement identities and the repeat bound.",
  "type": "object",
  "required": [
    "data",
    "format",
    "measurement_semantics_version",
    "revision",
    "saved_at",
    "schema_version",
    "sources",
    "study_uid"
  ],
  "properties": {
    "format": {
      "const": "sonoforge.study-measurements"
    },
    "schema_version": {
      "const": 2
    },
    "study_uid": {
      "type": "string",
      "maxLength": 64
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "saved_at": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "object",
      "maxProperties": 10000,
      "additionalProperties": {
        "type": "object",
        "required": [
          "fingerprint",
          "frames",
          "spacing"
        ],
        "additionalProperties": false,
        "properties": {
          "fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "frames": {
            "type": "integer",
            "minimum": 1
          },
          "spacing": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            ]
          }
        }
      }
    },
    "data": {
      "$ref": "#/$defs/StudyMeasurementData"
    },
    "measurement_semantics_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Meaning of Doppler labels/units; 2 = repeated measurements of one parameter are a list (D-23)."
    }
  },
  "additionalProperties": false,
  "$defs": {
