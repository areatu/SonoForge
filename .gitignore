# Byte-compiled / optimized / DLL files
__pycache__/

# Distribution / packaging
# NOTE: build/ is PyInstaller's default workpath, so it is ignored wholesale --
# but it also holds tracked packaging sources (build/linux/*.sh, build/windows/*,
# build/presenter/*, build/README.md) that were force-added. A NEW source file
# placed under build/ is silently skipped by `git add -A` and the build then
# fails on a fresh checkout. Put new helpers in scripts/ instead, or use
# `git add -f`.
.Python
build/
develop-eggs/
dist/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# macOS icon (generated in CI)
*.icns

# Virtual environments
.venv/
.venv-build/
.venv-*/
env/
venv/
ENV/
env.bak/
venv.bak/

# Presenter portable data (dev runs with SONOFORGE_PORTABLE=1 from repo root)
SonoForgePresenter-data/

# Environment variables
.env
.env.local
.env.*.local

